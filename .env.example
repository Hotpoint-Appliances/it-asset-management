DATABASE_URL=postgres://user:password@localhost:5432/itam_dev
PG_POOL_MAX=                                 # optional; pg pool size per process (default 10). PM2 cluster: instances x this < Postgres max_connections
JWT_SECRET=
ASSET_FILES_BASE_PATH=D:\itam_files          # Windows server disk path for images/attachments
MSAL_CLIENT_ID=
MSAL_CLIENT_SECRET=
MSAL_TENANT_ID=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_EMAIL_ENABLED=true              # false = in-app notifications only (dev/staging kill switch)
CRON_SECRET=                                 # shared secret required by /api/cron/* routes
ITAM_APP_URL=https://itam.internal.example   # public base URL: email links + QR labels (the scheduled script calls http://127.0.0.1:<port> instead)


# Creating the dev database
# psql -U postgres -c "CREATE ROLE itam_dev LOGIN PASSWORD '<generated-password>';"
# psql -U postgres -c "CREATE DATABASE itam_dev OWNER itam_dev;"